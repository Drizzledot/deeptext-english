{
  "name": "DeepText",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  "forwardPorts": [8000],

  "portsAttributes": {
    "8000": {
      "label": "DeepText",
      "onAutoForward": "openBrowser"
    }
  },

  "postCreateCommand": "cd backend && pip install -r requirements.txt"
}
